{
  "index_patterns": [
    "hayabusa-raw-*"
  ],
  "priority": 600,
  "_meta": {
    "description": "EVTXER raw Windows events (every event, curated fields, ECS like the detections). Priority above hayabusa-evtx (hayabusa-*), which would otherwise match hayabusa-raw-* too. Raw indices are named by Get-RawIndexName (hayabusa-raw-<mission>). Script block text is a wildcard field: a table can rank it and *DownloadString* is fast, at any length (a text field could do neither; a keyword drops what is past ignore_above). Every field the raw converter keeps ($script:RawEventFields) is mapped up front (one spelling of the case twins - Consumer, Param1-3, Name - since PowerShell 5.1 cannot read a JSON file with both), so a dashboard panel on a field no event has carried yet says No results instead of an error.",
    "managed_by": "hayabusa-project"
  },
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 0,
      "refresh_interval": "5s",
      "mapping.total_fields.limit": 10000
    },
    "mappings": {
      "dynamic": "false",
      "dynamic_templates": [
        {
          "event_data_string": {
            "path_match": "winlog.event_data.*",
            "match_mapping_type": "string",
            "mapping": {
              "type": "keyword",
              "ignore_above": 8191
            }
          }
        },
        {
          "event_data_long": {
            "path_match": "winlog.event_data.*",
            "match_mapping_type": "long",
            "mapping": {
              "type": "keyword",
              "ignore_above": 8191
            }
          }
        },
        {
          "event_data_double": {
            "path_match": "winlog.event_data.*",
            "match_mapping_type": "double",
            "mapping": {
              "type": "keyword",
              "ignore_above": 8191
            }
          }
        },
        {
          "event_data_boolean": {
            "path_match": "winlog.event_data.*",
            "match_mapping_type": "boolean",
            "mapping": {
              "type": "keyword",
              "ignore_above": 8191
            }
          }
        },
        {
          "event_data_date": {
            "path_match": "winlog.event_data.*",
            "match_mapping_type": "date",
            "mapping": {
              "type": "keyword",
              "ignore_above": 8191
            }
          }
        }
      ],
      "properties": {
        "@timestamp": {
          "type": "date"
        },
        "tags": {
          "type": "keyword"
        },
        "ecs": {
          "properties": {
            "version": {
              "type": "keyword"
            }
          }
        },
        "event": {
          "properties": {
            "id": {
              "type": "keyword"
            },
            "kind": {
              "type": "keyword"
            },
            "module": {
              "type": "keyword"
            },
            "dataset": {
              "type": "keyword"
            },
            "code": {
              "type": "keyword"
            },
            "ingested": {
              "type": "date"
            }
          }
        },
        "agent": {
